@using DcsMissionParser.Net.CoordMapping
@using DcsOpsBoard.Configuration
@using DcsOpsBoard.Database.Entities
@using DcsOpsBoard.Database.Services
@using DcsOpsBoard.Hubs
@using DcsOpsBoard.Hubs.HubModels
@using DcsOpsBoard.Hubs.MissionEditing
@using DcsOpsBoard.Services
@using DcsOpsBoard.Types
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using OpenLayers.Blazor

@rendermode InteractiveServer

@inject IMissionStorageManager MissionStorageManager
@inject HubConnectionProvider<CursorHub> CursorHubProvider
@inject IMissionSelectorService MissionSelectorService
@inject IUserMapSettings UserMapSettings
@inject IUserAuthenticationState AuthState
@inject IJSRuntime JS

@code {
    private OpsPlanningMission? _currentMission;
    private OpenLayers.Blazor.Map? _map;
    private Layer? _baseLayer;
    private Layer? _shaderLayer;
    private Layer? _detailedLayer;

    private Layer? _cursorLayer;
    private object BaseTileSourceOptions = new
    {
        MaxZoom = 15
    };

    private object ShaderTileSourceOptions = new
    {
        MaxZoom = 15
    };

    private object DetailedTileSourceOptions = new
    {
        MaxZoom = 17
    };

    private Task OnZoomChanged(double zoomLevel)
    {
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        MissionSelectorService.OnMissionSelected += SetCurrentMission;
    }

    private bool _pendingLimitsUpdate = false;
    public async Task SetCurrentMission(OpsPlanningMission mission)
    {
        _currentMission = mission;
        _pendingLimitsUpdate = true;

        await JS.InvokeVoidAsync("dcsMap.setActiveMap", _currentMission.Map.ToMapString());

        await JoinCursorsHub();
        await InvokeAsync(StateHasChanged);

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            UserMapSettings.OnSettingsChanged += StateHasChanged;
        }
    }

    private bool _registeredCursorHandler = false;
    private async Task JoinCursorsHub()
    {
        if (_currentMission == null)
        {
            return;
        }

        await AuthState.EnsureLoaded();
        if (!AuthState.IsAuthenticated || AuthState.DiscordId is null)
        {
            return;
        }

        await CursorHubProvider.EnsureStartedAsync();

        if (_registeredCursorHandler) return;

        CursorHubProvider.Connection.On<CursorData>(CursorHub.ReceivedCursorPositionMethodName, async (data) =>
        {
            if (!UserMapSettings.ShowFriendlyCursors)
            {
                return;
            }

            _ = UpdateCursor(data);
        });

        _registeredCursorHandler = true;
    }

    private readonly Dictionary<string, Shape> _cursorShapes = [];
    public async Task UpdateCursor(CursorData data)
    {
        if (_currentMission == null || _currentMission.MissionId != data.MissionId)
        {
            return;
        }

        if (_cursorLayer is null)
            return;

        var cursorId = "cursor-" + data.UserId;

        if (!_cursorShapes.TryGetValue(cursorId, out var shape))
        {
            shape = new Shape(ShapeType.Point)
            {
                Id = cursorId,
                Coordinates = new Coordinates(new Coordinate(data.Lon, data.Lat)),
            };

            _cursorShapes[cursorId] = shape;
            _cursorLayer.ShapesList.Add(shape);
            await _cursorLayer.UpdateLayer();
            return;
        }

        shape.Coordinates = new Coordinates(new Coordinate(data.Lon, data.Lat));
        await shape.UpdateCoordinates();
    }

    
    public Extent? GetExtent()
    {
        if(_currentMission == null)
        {
            return null;
        }

        var limits = _currentMission.Map.Limits;
        return new Extent(
            limits.BottomLeft.Lon,
            limits.BottomLeft.Lat,
            limits.TopRight.Lon,
            limits.TopRight.Lat);
    }

}


<div class="map-container">

    @if (_currentMission != null)
    {
        <Map
            @key="@($"map-{_currentMission.MissionId}")" 
            @ref="_map"
            style=@($"height: 100%; width: 100%; z-index: 0; {(_currentMission == null ? "display:none;" :
                                  "")}") ZoomChanged="OnZoomChanged" MaxZoom="_currentMission!.Map.MaxZoom" MinZoom="_currentMission.Map.MinZoom"
             ConfigureJsMethod="dcsMap.configureDetailedLayerLookup">
            <Layers>

                <Layer @key="@(_currentMission?.MissionId)"
                        @ref="_baseLayer" Id="base-layer" 
                        Visibility="true"
                        SourceType="SourceType.XYZ" 
                        SourceOptions="BaseTileSourceOptions"
                       Url=@($"/api/tiles/{_currentMission?.Map.ToMapString()}/{{z}}/{{x}}/{{y}}.webp") Format="image/webp" />

                @* Detailed layer is loaded dynamically via JS to avoid unnecessary tile loading *@
                <Layer @ref="_detailedLayer" Id="detailed-layer" SourceType="SourceType.XYZ"
                       SourceOptions="DetailedTileSourceOptions" MinZoom="15" Format="image/webp" />

                <Layer @ref="_shaderLayer" Id="shader-layer" SourceOptions="ShaderTileSourceOptions"
                       Visibility="@(UserMapSettings.ShowElevationShader)"
                       Url=@($"/api/shaders/{_currentMission?.Map.ToMapString()}/{{z}}/{{x}}/{{y}}.webp") MinZoom="6"
                       SourceType="SourceType.XYZ" Opacity="0.20" Format="image/webp" />

                <Layer @ref="_cursorLayer" Id="cursor-layer" LayerType="LayerType.Vector"
                       Visibility="@(UserMapSettings.ShowFriendlyCursors)" />
            </Layers>
        </Map>
    }
    else
    {
        <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
            <h1 style="text-align: center;">No mission selected</h1>
        </div>
    }

</div>