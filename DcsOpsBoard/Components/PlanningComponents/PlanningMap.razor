@using DcsOpsBoard.Configuration
@using DcsOpsBoard.Services
@using DcsOpsBoard.Types
@using OpenLayers.Blazor
@using Microsoft.JSInterop

@rendermode InteractiveServer

@inject IUserMapSettings UserMapSettings
@inject IJSRuntime JS

@code {
    private Guid currentMission = Guid.Empty;
    private OpenLayers.Blazor.Map? _map;
    private Layer? _baseLayer;
    private Layer? _shaderLayer;
    private Layer? _detailedLayer;
    private Layer? _buildupLayer;
    private Layer? _objectLayer;

    private DcsOpsBoard.Types.Map CurrentMap = DcsOpsBoard.Types.Map.Unknown;
    private string mapName => CurrentMap != DcsOpsBoard.Types.Map.Unknown ? CurrentMap.ToString().ToLower() : "unknown";

    private object BaseTileSourceOptions = new
    {
        MaxZoom = 15
    };

    private object ShaderTileSourceOptions = new
    {
        MaxZoom = 15
    };

    private object DetailedTileSourceOptions = new
    {
        MaxZoom = 17
    };

    private Task OnZoomChanged(double zoomLevel)
    {
        return Task.CompletedTask;
    }

    public async Task SetCurrentMission(Guid mission)
    {
        currentMission = mission;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            UserMapSettings.OnSettingsChanged += StateHasChanged;
            CurrentMap = DcsOpsBoard.Types.Map.Caucasus;
            await SetLimits();

            // Push initial map to JS state without recreating map/layers.
            await JS.InvokeVoidAsync("dcsMap.setActiveMap", mapName);

            StateHasChanged();
        }
    }

    public async Task SetMap(DcsOpsBoard.Types.Map map)
    {
        CurrentMap = map;
        await SetLimits();

        // Update JS lookup state (no full map reload).
        await JS.InvokeVoidAsync("dcsMap.setActiveMap", mapName);

        StateHasChanged();
    }

    public async Task SetLimits()
    {
        if (_map == null || _baseLayer == null) return;

        var limits = CurrentMap.Limits;
        await _map.SetZoom(CurrentMap.ZoomLevel);

        Extent extent = new Extent(
            limits.BottomLeft.Lon,
            limits.BottomLeft.Lat,
            limits.TopRight.Lon,
            limits.TopRight.Lat);

        _baseLayer.Extent = extent;
    }
}


<div class="map-container">
    @if (currentMission != Guid.Empty || true)
    {
        <Map @ref="_map"
             style="height: 100%; width: 100%; z-index: 0;"
             ZoomChanged="OnZoomChanged"
             MaxZoom="17"
             MinZoom="6"
             ConfigureJsMethod="dcsMap.configureDetailedLayerLookup">
            <Layers>

                <Layer @ref="_baseLayer"
                       Id="base-layer"
                       SourceType="SourceType.XYZ"
                       Url="@($"/api/tiles/{mapName}/{{z}}/{{x}}/{{y}}.webp")"
                       SourceOptions="BaseTileSourceOptions"
                       Format="image/webp" />

                  @* Detailed layer is loaded dynamically via JS to avoid unnecessary tile loading *@
                <Layer @ref="_detailedLayer"
                       Id="detailed-layer"
                       SourceType="SourceType.XYZ"
                       SourceOptions="DetailedTileSourceOptions"
                       MinZoom="15"
                       Format="image/webp" />

                <Layer @ref="_shaderLayer"
                       Id="shader-layer"
                       SourceOptions="ShaderTileSourceOptions"
                       Visibility="@(UserMapSettings.ShowElevationShader)"
                       MinZoom="6"
                       SourceType="SourceType.XYZ"
                       Url="@($"/api/shaders/{mapName}/{{z}}/{{x}}/{{y}}.webp")"
                       Opacity="0.20"
                       Format="image/webp" />
            </Layers>
        </Map>
    }
    else
    {
        <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
            <h1 style="text-align: center;">No mission selected</h1>
        </div>
    }
</div>