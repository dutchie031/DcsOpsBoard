@using System.Text.Json
@using DcsMissionParser.Net
@using DcsMissionParser.Net.CoordMapping
@using DcsMissionParser.Net.Objects.Coalitions.Countries.Groups
@using DcsMissionParser.Net.Objects.Coalitions.Routes.Plane.Tasks
@using DcsOpsBoard.Components.Modals.Warnings
@using DcsOpsBoard.Components.PlanningComponents.HelperClasses
@using DcsOpsBoard.Configuration
@using DcsOpsBoard.Constants
@using DcsOpsBoard.Database.Entities
@using DcsOpsBoard.Database.Enums
@using DcsOpsBoard.Database.Services
@using DcsOpsBoard.Hubs
@using DcsOpsBoard.Hubs.Clients
@using DcsOpsBoard.Hubs.HubModels
@using DcsOpsBoard.MissionEditing
@using DcsOpsBoard.MissionEditing.RenderExtensions
@using DcsOpsBoard.Services
@using DcsOpsBoard.Types
@using DcsOpsBoard.Types.Enums
@using DcsPlanePoint = DcsMissionParser.Net.Objects.Coalitions.Routes.Plane.Point
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using OpenLayers.Blazor

@rendermode InteractiveServer

@implements IDisposable

@inject IMissionEditingClient MissionEditingClient
@inject HubConnectionProvider<CursorHub> CursorHubProvider
@inject IUserMapSettings UserMapSettings
@inject IUserAuthenticationState AuthState
@inject IUnitSelectorService UnitSelectorService
@inject WarningService WarningService
@inject IJSRuntime JS

@code {

    private OpenLayers.Blazor.Map _map = null!;
    private Layer _extentLayer = null!;
    private Layer? _baseLayer;
    private Layer? _shaderLayer;
    private Layer? _detailedLayer;
    private Layer? _objectsLayer;

    private readonly MissionRenderState _renderState = new();
    
    private CursorHelper _cursorHelper = null!;

    private Layer? _cursorLayer;
    private object BaseTileSourceOptions = new
    {
        MaxZoom = 15
    };

    private object ShaderTileSourceOptions = new
    {
        MaxZoom = 15
    };

    private object DetailedTileSourceOptions = new
    {
        MaxZoom = 17
    };

    private object VectorTileSourceOptions = new
    {
        MaxZoom = 17,
        MinZoom = 12,
        TileSize = 512,
        WrapX = false,
        Projection = "EPSG:3857"
    };

    private object DrawingLayerOptions = new 
    {
        updateWhileAnimating = true,
        updateWhileInteracting = true
    };

    private Task OnZoomChanged(double zoomLevel)
    {
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        MissionEditingClient.OnMissionChanged += MissionChanged;
        MissionEditingClient.OnMissionReceived += MissionEditingClient_OnMissionReceived;

        _cursorHelper = new CursorHelper
        {
            AuthState = AuthState,
            CursorHubProvider = CursorHubProvider,
            UserMapSettings = UserMapSettings,
            CursorLayer = _cursorLayer
        };
    }

    public async Task MissionChanged()
    {

        await JS.InvokeVoidAsync("dcsMap.setActiveMap", MissionEditingClient.CurrentMissionData?.Map.ToMapString());

        _renderState.Clear();

        await _cursorHelper.JoinCursorsHub(MissionEditingClient.CurrentMissionData?.MissionId ?? Guid.Empty);
        await InvokeAsync(StateHasChanged);

        _cursorHelper.CursorLayer = _cursorLayer;

    }

    public async Task MissionEditingClient_OnMissionReceived()
    {
        _map?.ShapesList.Clear();
        foreach(Layer layer in _map?.LayersList ?? [])
        {
            layer.ShapesList.Clear();
        }
        await InvokeAsync(StateHasChanged);
        if(MissionEditingClient.CurrentMissionData != null && MissionEditingClient.CurrentMission != null)
        {
            await MissionEditingClient.CurrentMission.RenderAsync(MissionEditingClient.CurrentRoleInMission, [], _map, _renderState, MissionEditingClient.CurrentMissionData.Map.CoordConverter);
        }
       
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            UserMapSettings.OnSettingsChanged += StateHasChanged;
        }

        UpdateDotNetRef();
    }

#region Mission Editor 

    private DotNetObjectReference<PlanningMap>? _dotNetRef;

    public void UpdateDotNetRef()
    {
        if (_dotNetRef != null)
        {
            _dotNetRef.Dispose();
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        JS.InvokeVoidAsync("dcsMap.setRazorReference", _dotNetRef);
    }

    private Dictionary<Guid, Shape> _drawnShapes = [];
    
    private UnitSelectedArgs? _lastSelectedUnit;
    private async Task UnitSelectorService_OnGroupSelected(UnitSelectedArgs args)
    {
        if(_lastSelectedUnit != null)
        {
            if(_lastSelectedUnit.SelectedType == typeof(PlaneGroup) && _lastSelectedUnit.SelectedUnit is PlaneGroup lastGroup)
            {
                
            }
        }

        if(args.SelectedType == typeof(PlaneGroup) && args.SelectedUnit is PlaneGroup group)
        {
            
        }
    }

    private async Task HandleMissionUpdate(IMissionCommand command)
    {
        
    }
    
    public async Task SelectedShapeChanged(Shape shape)
    {
        if(shape == null)
        {
            return;
        }
        

        shape.Properties.TryGetValue(MapConstants.ItemSelectableKey, out var selectableObj);
        if (selectableObj is not bool selectable || !selectable)
        {
            shape.Layer.SelectedShape = null;
            shape.Layer.UpdateLayer();
            return;
        }

    }

    [JSInvokable]
    public async Task OnItemMoved(Guid featureId, double lon, double lat)
    {   
        
        if(!_renderState.TryGetShape(featureId, out Shape? shape))
        {
            Console.WriteLine($"Shape with id {featureId} not found");
            return;
        }

        string type = shape.Properties.ContainsKey("$type") ? shape.Properties["$type"].ToString() ?? "unknown" : "unknown";

        Console.WriteLine($"Item {featureId} of type {type} moved to {lon}, {lat}");

        // TODO: Update your mission data here
        // TODO: Send update via SignalR
    }

    [JSInvokable]
    public async Task OnItemMoving(Guid featureId, double lon, double lat)
    {
        if(!_renderState.TryGetShape(featureId, out Shape? shape))
        {
            Console.WriteLine($"Shape with id {featureId} not found");
            return;
        }

        string type = shape.Properties.ContainsKey("$type") ? shape.Properties["$type"].ToString() ?? "unknown" : "unknown";

        if(type == MapConstants.ShapeTypes.FlightWaypoint)
        {
            if(shape.Properties.TryGetValue(MapConstants.FlightIdKey, out var flightIdObj) && flightIdObj is Guid flightId)
            {
                if(_renderState.TryGetFlight(flightId, out PlaneGroup? flight))
                {
                    DcsPlanePoint? changedPoint = flight.Route.Points.FirstOrDefault(p => p.RefId == featureId);
                    
                    if(changedPoint != null)
                    {
                        var coordConverter = MissionEditingClient.CurrentMissionData!.Map.CoordConverter;
                        DcsCoord dcsCoord = coordConverter.LLtoLO(new LatLong{ Lat = lat, Lon = lon });
                        changedPoint.X = dcsCoord.X;
                        changedPoint.Y = dcsCoord.Y;

                        // Update local only by redrawing the entire flight.
                        if(_renderState.TryGetFlightCoalition(flightId, out CoalitionSide coalition))
                        {
                            await flight.RenderAsync(coalition, MissionEditingClient.CurrentRoleInMission, [], _map, _renderState, MissionEditingClient.CurrentMissionData!.Map.CoordConverter);
                        }
                    }
                }
            }
        }
    }

#endregion


    public Extent GetExtent()
    {
        if(MissionEditingClient.CurrentMissionData == null )
        {
            return null;
        }
        var limits = MissionEditingClient.CurrentMissionData.Map.Limits;
        return new Extent(
            limits.BottomLeft.Lon,
            limits.BottomLeft.Lat,
            limits.TopRight.Lon,
            limits.TopRight.Lat);
    }

    private StyleOptions GetObjectLayerStyle()
    {
        return new StyleOptions
        {
            Fill = new StyleOptions.FillOptions { Color = "rgba(255,0,255,0.5)" },
            Stroke = new StyleOptions.StrokeOptions { Color = "#000", Width = 3 },
            Circle = new StyleOptions.CircleStyleOptions
            {
                Radius = 8,
                Fill = new StyleOptions.FillOptions { Color = "rgba(255,255,0,0.5)" },
                Stroke = new StyleOptions.StrokeOptions { Color = "#000000", Width = 2 }
            }
        };
    }
    
    public void Dispose()
    {
        UserMapSettings.OnSettingsChanged -= StateHasChanged;
        _dotNetRef?.Dispose();
    }

    public async Task OnPointerMove(Coordinate coordinate)
    {
        await _cursorHelper.SignalPointerMove(coordinate);
    }
}

<div class="map-container">
    @if (MissionEditingClient.CurrentMissionData != null)
    {
        <Map
            OnPointerMove="OnPointerMove"
            @key="@($"map-{MissionEditingClient.CurrentMissionData.MissionId}")" 
            @ref="_map"
            style=@($"height: 100%; width: 100%; z-index: 0; {(MissionEditingClient.CurrentMissionData == null ? "display:none;" :
                                  "")}") ZoomChanged="OnZoomChanged" MaxZoom="@(MissionEditingClient.CurrentMissionData!.Map.MaxZoom)" MinZoom="@(MissionEditingClient.CurrentMissionData!.Map.MinZoom)"
             ConfigureJsMethod="dcsMap.configureMap">
            <Layers>

                <Layer @ref="_extentLayer" Extent="@GetExtent()" Opacity="0"/>

                <Layer @key="@($"base-layer-{MissionEditingClient.CurrentMissionData.MissionId}")"
                        @ref="_baseLayer" Id="base-layer" 
                        Visibility="true"
                        SourceType="SourceType.XYZ" 
                        SourceOptions="BaseTileSourceOptions"
                       Url=@($"/api/tiles/{MissionEditingClient.CurrentMissionData.Map.ToMapString()}/{{z}}/{{x}}/{{y}}.webp") Format="image/webp" />

                @* Detailed layer is loaded dynamically via JS to avoid unnecessary tile loading *@
                <Layer @ref="_detailedLayer" Id="detailed-layer" SourceType="SourceType.XYZ"
                       SourceOptions="DetailedTileSourceOptions" MinZoom="15" Format="image/webp" />

                <Layer @ref="_shaderLayer" Id="shader-layer" SourceOptions="ShaderTileSourceOptions"
                       Visibility="@(UserMapSettings.ShowElevationShader)"
                       Url=@($"/api/shaders/{MissionEditingClient.CurrentMissionData.Map.ToMapString()}/{{z}}/{{x}}/{{y}}.webp") MinZoom="6"
                       SourceType="SourceType.XYZ" Opacity="0.20" Format="image/webp" />
                
                <Layer @ref="_objectsLayer" Id="object-layer" 
                    SourceType="SourceType.VectorMVT" LayerType="LayerType.VectorTile"
                    MinZoom="12" MaxZoom="17"
                    SourceOptions="VectorTileSourceOptions"
                    Style="@GetObjectLayerStyle()"
                    Visibility="true" />

                <Layer Id="@MapConstants.DrawingLayerId" 
                    LayerType="LayerType.Vector"
                    Options="@DrawingLayerOptions"
                    Visibility="@(UserMapSettings.ShowDrawingLayer)"
                    />

                <Layer Id="@MapConstants.EditableFlightsLayerId" 
                    LayerType="LayerType.Vector"
                    Options="@DrawingLayerOptions"
                    />

                <Layer Id="@MapConstants.NonEditableFlightsLayerId" 
                    LayerType="LayerType.Vector"
                    Options="@DrawingLayerOptions"
                    />

                <Layer @ref="_cursorLayer" Id="cursor-layer" LayerType="LayerType.Vector"
                       Visibility="@(UserMapSettings.ShowFriendlyCursors)" />
            </Layers>
            
        </Map>
    }
    else
    {
        <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
            <h1 style="text-align: center;">No mission selected</h1>
        </div>
    }

</div>