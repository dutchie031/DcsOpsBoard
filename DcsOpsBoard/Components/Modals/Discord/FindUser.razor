@using DcsOpsBoard.Components.Modals.Warnings
@using DcsOpsBoard.Services.Discord

@inject IDiscordClient DiscordService
@inject IFindUserService FindUserService
@inject WarningService WarningService

@code {

    private bool _modalVisible = false;

    private string? _selectedGuildId;

    private TaskCompletionSource<DiscordUser?>? _tcs;

    protected override void OnInitialized()
    {
        FindUserService.OnFindUserRequested = ShowAndWait;
    }

    public async Task<DiscordUser?> ShowAndWait()
    {   
        _tcs = new TaskCompletionSource<DiscordUser?>(TaskCreationOptions.RunContinuationsAsynchronously);
        ShowModal();
        return await _tcs.Task;
    }

    public void ShowModal()
    {
        _modalVisible = true;
        InvokeAsync(StateHasChanged);
    }

    public void HideModal()
    {
        _modalVisible = false;
        InvokeAsync(StateHasChanged);
    }

    public async Task ClosedWithoutSelection()
    {
        _tcs?.TrySetResult(null);
        HideModal();
    }

    public async Task UserSelected(DiscordUser user)
    {
        _tcs?.TrySetResult(user);
        HideModal();
    }

    public async Task GuildSelected(ChangeEventArgs e)
    {
        _selectedGuildId = e.Value?.ToString();
        StateHasChanged();
    }

    
    private List<PartialGuild> _guilds = [];
    public async Task RefreshGuilds()
    {
        var result = await DiscordService.GetGuildsForUserAsync();
        if (result.Success && result.Data != null)
        {
            _guilds = result.Data!;
        }
        else
        {            
            _ = WarningService.ShowWarningAsync("Could not fetch guilds", $"Error fetching guilds: {result.ErrorMessage}", severity: WarningSeverity.ERROR);
            _guilds = [];
        }
        StateHasChanged();
    }
}

<div class="modal fade @( _modalVisible ? "show" : "" )" tabindex="-1" role="dialog" @onclick="ClosedWithoutSelection">
    <div class="modal-dialog" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Find Discord User</h5>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    @* Select Guild to search in TODO: Include friends? *@
                    @* refresh button (in case of error) *@
                </div>

                <div class="form-group">
                    @* Input for username and discriminator. Visible when a guild is selected *@
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="ClosedWithoutSelection">Cancel</button>
            </div>
        </div>
    </div>

</div>
