<h3>Warning</h3>

@inject WarningService WarningService

@code {

    protected override void OnInitialized()
    {
        WarningService.ShowWarning += ShowWarning;
    }

    private string _title = "";
    private string _message = "";
    private WarningSeverity _severity = WarningSeverity.INFO;
    private bool _visible = false;

    public async Task ShowWarning(string title, string message, WarningSeverity severity)
    {
        _title = title;
        _message = message;
        _severity = severity;
        _visible = true;
        StateHasChanged();
    }

    private async Task Hide()
    {
        _visible = false;
        StateHasChanged();
    }
}


<div class="modal fade @(_visible ? "show" : "hidden")" tabindex="-1" role="dialog" @onclick="Hide">
    <div class="modal-dialog" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@_title</h5>
            </div>
            <div class="modal-body">
                @_message
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Hide">Ok</button>
            </div>
        </div>
    </div>
</div>
