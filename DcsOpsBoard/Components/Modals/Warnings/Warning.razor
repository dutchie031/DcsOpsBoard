@inject WarningService WarningService

@code {

    protected override void OnInitialized()
    {
        WarningService.ShowWarning += ShowWarning;
    }

    private string _title = "";
    private string _message = "";
    private WarningSeverity _severity = WarningSeverity.INFO;
    private bool _visible = false;

    public async Task ShowWarning(string title, string message, WarningSeverity severity)
    {
        _title = title;
        _message = message;
        _severity = severity;
        _visible = true;
        StateHasChanged();
    }

    private async Task Hide()
    {
        _visible = false;
        StateHasChanged();
    }
}


<div class="modal fade @(_visible ? "show" : "hidden")" tabindex="-1" role="dialog" @onmousedown="Hide" style="z-index: 2000;">
    <div class="modal-dialog" role="document" @onmousedown:stopPropagation>
        <div class="modal-content" style="width:60vw;">
            <div class="modal-header">
                    
                    <h5 class="modal-title">
                        @switch (_severity)
                        {
                            case WarningSeverity.INFO:
                                <span class="bi bi-info-circle-fill mr-2 text-info" title="Info" aria-hidden="true"></span>
                                break;
                            case WarningSeverity.WARNING:
                                <span class="bi bi bi-exclamation-circle-fill text-warning mr-2" title="Warning" aria-hidden="true"></span>
                                break;
                            case WarningSeverity.ERROR:
                                <span class="bi bi bi-exclamation-circle-fill text-danger mr-2" title="Error" aria-hidden="true"></span>
                                break;
                        }
                        @(" " + _title)
                    </h5>
                
            </div>
            <div class="modal-body">
                @((MarkupString)_message)
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Hide">Ok</button>
            </div>
        </div>
    </div>
</div>
