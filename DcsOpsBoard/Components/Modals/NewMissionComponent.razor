@using DcsMissionParser.Net
@using DcsOpsBoard.Components.Common
@using DcsOpsBoard.Components.Modals.Warnings
@using DcsOpsBoard.Database.Services
@using DcsOpsBoard.Services
@using DcsOpsBoard.Types
@using Microsoft.AspNetCore.Components.Forms

@inject IUserAuthenticationState AuthState;
@inject IMissionStorageManager MissionStorageManager;
@inject WarningService WarningService;

@code {

    [Parameter]
    public EventCallback<bool> ModalVisibilityChanged { get; set; }

    [Parameter]
    public EventCallback MissionCreated { get; set; }
    
    private NewMissionModel model = new NewMissionModel();
    private bool isDragOver;

    public void ShowNew()
    {
        model = new NewMissionModel();
        isDragOver = false;
        isVisible = true;
        ModalVisibilityChanged.InvokeAsync(true);
        StateHasChanged();
    }

    private bool isVisible = false;
    private void Hide()
    {
        isVisible = false;
        StateHasChanged();
        ModalVisibilityChanged.InvokeAsync(false);
    }

    private async Task CreateMission()
    {
        if (!AuthState.IsAuthenticated)
        {
            await WarningService.ShowWarningAsync("Not authenticated", "You must be logged in to create a mission.", WarningSeverity.ERROR);
            return;
        }

        ulong? userId = AuthState.DiscordId;
        if (userId == null)
        {
            await WarningService.ShowWarningAsync("User ID not found", "Unable to retrieve your user ID.", WarningSeverity.ERROR);
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrWhiteSpace(model.Description))
        {
            await WarningService.ShowWarningAsync("Invalid input", "Mission name and description cannot be empty.", WarningSeverity.ERROR);
            return;
        }

        if (model.MissionFile == null)
        {
            await WarningService.ShowWarningAsync("No mission file", "You must select a mission file.", WarningSeverity.ERROR);
            return;
        }
        
        using MemoryStream ms = new MemoryStream();
        //Max File size 10MB for now
        await model.MissionFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);

        byte[] bytes = ms.ToArray();

        ParseResult<DcsMission> mission = await MizSerializer.Deserialize(bytes);
        if(!mission.Success)
        {
            await WarningService.ShowWarningAsync("Invalid mission file", "The selected mission file is invalid.", WarningSeverity.ERROR);
            return;
        }

        Map map = mission.Result?.Theatre?.ToMap() ?? Map.Unknown;

        if (map == Map.Unknown)
        {
            await WarningService.ShowWarningAsync("Unsupported map", "The mission file contains an unsupported map.", WarningSeverity.ERROR);
            return;
        }

        _ = await MissionStorageManager.CreateNewMission(bytes, model.MissionFile.Name, model.Name, model.Description, userId.Value, model.MissionType, map);
        
        await MissionCreated.InvokeAsync(null);
        Hide();
    }

    private void OnDragEnter()
    {
        isDragOver = true;
    }

    private void OnDragLeave()
    {
        isDragOver = false;
    }

    private void OnDrop(DragEventArgs _)
    {
        isDragOver = false;
    }

    private void OnMissionFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File.Name.EndsWith(".miz", StringComparison.OrdinalIgnoreCase))
        {
            model.MissionFile = e.File;

            //TODO: file scanning/validation can be added here if desired.
        }

        // TODO: Provide user feedback if the file is not a .miz file.
    }

    private async Task OnMissionTypeSelected(MissionType type)
    {
        model.MissionType = type;
    }

    private class NewMissionModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public IBrowserFile? MissionFile { get; set; }
        public MissionType MissionType { get; set; } = MissionType.Singleplayer;
    }
}

<div class="modal fade @(isVisible ? "show" : "hidden")" tabindex="-1" role="dialog" @onclick="Hide">
    <div class="modal-dialog" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Mission</h5>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="missionName">Mission Name</label>
                    <input type="text" class="form-control text" id="missionName" @bind="model.Name" />
                </div>
                <div class="form-group">
                    <label for="missionDescription">Mission Description</label>
                    <textarea class="form-control text" id="missionDescription" rows="3"
                              @bind="model.Description"></textarea>
                </div>
                <div class="form-group">
                    <div class="w-100 pt-3">
                        <HorizontalPicker TOption="MissionType" Options="MissionTypeEnum.GetPickerDictionary()" FullWidth="true" OnOptionSelected="OnMissionTypeSelected" />
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label>Mission File</label>
                    <div class="drop-zone @(isDragOver ? "drag-over" : "")" @ondragenter="OnDragEnter"
                         @ondragleave="OnDragLeave" @ondragover:preventDefault="true" @ondrop="OnDrop"
                         @ondrop:preventDefault="true">
                        <InputFile OnChange="OnMissionFileSelected" class="file-input-overlay" />
                        <div class="drop-zone-content">
                            @if (model.MissionFile == null)
                            {
                                <p class="mb-1">Drag and drop one file here</p>
                                <p class="mb-0 text-muted">or click to browse</p>
                            }
                            else
                            {
                                <p class="mb-0">Selected: @model.MissionFile.Name</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="CreateMission">Create your mission</button>
                <button type="button" class="btn btn-secondary" @onclick="Hide">Close</button>
            </div>
        </div>
    </div>
</div>