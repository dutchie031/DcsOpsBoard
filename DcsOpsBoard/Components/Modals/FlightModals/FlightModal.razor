@using DcsMissionParser.Net.Annotations
@using DcsMissionParser.Net.Objects.Coalitions.Countries.Groups
@using DcsMissionParser.Net.Objects.Coalitions.Units.Plane
@using DcsMissionParser.Net.Objects.Commons
@using DcsOpsBoard.Components.Modals.DraggableModal
@using DcsOpsBoard.Hubs.Clients
@using DcsOpsBoard.Types.Enums
@inject IFlightModalService FlightModalService
@inject IMissionEditingClient MissionClientService

@code {

    private bool _modalVisible;

    public async Task SaveAndClose()
    {
        _modalVisible = false;
        StateHasChanged();
    }

    public async Task CloseWithoutSaving()
    {
        _modalVisible = false;
    }

    private IEnumerable<PlaneType> PlaneTypes => PlaneType.GetAll<PlaneType>().OrderBy(pt => pt.Value);
    private PlaneType? SelectedPlaneType => SelectedFlight?.Units.FirstOrDefault()?.Type;
    private Skill? SelectedSkill => SelectedFlight?.Units.FirstOrDefault()?.Skill;
    
    private PlaneGroup? SelectedFlight;
    private bool IsReadOnly;
    
    protected override void OnInitialized()
    {
        FlightModalService.OnCreateFlightModalRequested += FlightModalService_OnCreateFlightModalRequested;
        FlightModalService.OnEditFlightModalRequested += FlightModalService_OnEditFlightModalRequested;
    }

    private async Task FlightModalService_OnCreateFlightModalRequested(CoalitionSide side, bool isClientFlight)
    {
        if(MissionClientService.CurrentMission == null)
            return;

        int nextGroupId = MissionClientService.CurrentMission.NextGroupId;
        SelectedFlight = new PlaneGroup
        {
            GroupName = $"New Flight-{nextGroupId}",
            GroupId = nextGroupId,
            Tasking = PlaneTasking.Nothing,
            IsHidden = false
        };
        
        IsReadOnly = false;
        _modalVisible = true;
        StateHasChanged();
    }
    
    private async Task FlightModalService_OnEditFlightModalRequested(PlaneGroup flight, bool isReadOnly)
    {
        SelectedFlight = flight;
        IsReadOnly = isReadOnly;
        _modalVisible = true;
        StateHasChanged();
    }

    private async Task OnTaskingSelected(PlaneTasking tasking)
    {
        if (SelectedFlight == null)
            return;

        SelectedFlight.Tasking = tasking;
        await InvokeAsync(StateHasChanged);
    }
}

<DraggableModal ZIndex="1100" IsVisible="_modalVisible" OnClose="CloseWithoutSaving">
    <Header>
        @if (SelectedFlight != null)
        {
            <h3 class="modal-title">@SelectedFlight.GroupName</h3>
        }
        else
        {
            <h3 class="modal-title">New Flight</h3>
        }
    </Header>
    <Body>
        <div class="container-fluid modal-content bg-transparent" style="min-width: 500px;">
            <div class="row">
                <div class="col-6">
                    <div class="mb-3">
                        <label for="flightName" class="form-label">Flight Name</label>
                        <input type="text" id="flightName" class="form-control input-text" @bind="SelectedFlight.GroupName" readonly="@IsReadOnly" />
                    </div>
                    
                </div>
                <div class="col-6">
                    <div class="mb-3">
                        <label for="taskingType" class="form-label">Tasking</label>
                        <select id="taskingType" class="form-select" disabled="@IsReadOnly">
                            @foreach (var tasking in StringEnum.GetAll<PlaneTasking>() )
                            {
                                <option value="@tasking" selected="@(SelectedFlight.Tasking == tasking)" @onselect="() => OnTaskingSelected(tasking)">@tasking.Value</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <div class="mb-3">
                        <label for="planeType" class="form-label">Plane Type</label>
                        <select id="planeType" class="form-select" disabled="@IsReadOnly">
                            @foreach (var planeType in PlaneTypes)
                            {
                                <option value="@planeType" selected="@(SelectedPlaneType != null && SelectedPlaneType.Value == planeType.Value)">@planeType.Value</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-3">
                        <label for="skill" class="form-label">Skill</label>
                        <select id="skill" class="form-select" disabled="@IsReadOnly">
                            @foreach (var skill in StringEnum.GetAll<Skill>())
                            {
                                <option value="@skill" selected="@(SelectedSkill != null && SelectedSkill.Value == skill.Value)">@skill.Value</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </Body>
</DraggableModal>

