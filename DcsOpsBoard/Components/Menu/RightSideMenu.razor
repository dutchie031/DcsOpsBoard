@using DcsOpsBoard.Hubs.Clients
@using DcsOpsBoard.Services
@rendermode InteractiveServer

@inject IUserMapSettings UserMapSettings
@inject IMissionEditingClient MissionEditingClient

@code {
    
    protected override void OnInitialized()
    {
        UserMapSettings.OnSettingsChanged += StateHasChanged;
        MissionEditingClient.OnMissionChanged += OnMissionChanged;
        base.OnInitialized();
    }
    

    private void ToggleElevationData()
    {
        UserMapSettings.ShowElevationShader = !UserMapSettings.ShowElevationShader;
    }

    private void ToggleCursors()
    {
        UserMapSettings.ShowFriendlyCursors = !UserMapSettings.ShowFriendlyCursors;
    }

    private async Task OnMissionChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawingLayer()
    {
        UserMapSettings.ShowDrawingLayer = !UserMapSettings.ShowDrawingLayer;
    }

}

@if(MissionEditingClient == null)
{
    return;
}

<div id="right-menu-body">
    <div class="right-menu-grouping h-25">
        <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowElevationShader ? "selected" : "")" @onclick="ToggleElevationData">
                <i class="icon-l icon-mountain"></i>
            </div>
            <div class="right-menu-content">
                <span>Elevation Data</span>
            </div>
        </div>
    </div>

    <div class="right-menu-grouping h-50">
         <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowDrawingLayer ? "selected" : "")" @onclick="ToggleDrawingLayer">
                <i class="bi bi-brush"></i>
            </div>
            <div class="right-menu-content">
                <span>Drawing Layer</span>
            </div>
        </div>
    </div>

     <div class="right-menu-grouping h-20">
       <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowFriendlyCursors ? "selected" : "")" @onclick="ToggleCursors">
                <i class="bi bi-cursor"></i>
            </div>
            <div class="right-menu-content">
                <span>Friendly Cursors</span>
            </div>
        </div>
    </div>
    
</div>