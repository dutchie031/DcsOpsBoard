@using DcsOpsBoard.Hubs.Clients
@using DcsOpsBoard.Services
@rendermode InteractiveServer

@inject IUserMapSettings UserMapSettings
@inject IMissionEditingClient MissionEditingClient

@code {
    
    protected override void OnInitialized()
    {
        UserMapSettings.OnSettingsChanged += StateHasChanged;
        MissionEditingClient.OnMissionChanged += OnMissionChanged;
        base.OnInitialized();
    }
    
    private async Task OnMissionChanged()
    {
        await InvokeAsync(StateHasChanged);
    }


}

@if(MissionEditingClient == null)
{
    return;
}

<div id="right-menu-body">
    <div class="right-menu-grouping h-25">
         <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowBaseLayer ? "selected" : "")" @onclick="() => UserMapSettings.ShowBaseLayer = !UserMapSettings.ShowBaseLayer">
                <i class="bi bi-map"></i>
            </div>
            <div class="right-menu-content">
                <span>Base Layer</span>
            </div>
        </div>
        <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowElevationShader ? "selected" : "")" @onclick="() => UserMapSettings.ShowElevationShader = !UserMapSettings.ShowElevationShader">
                <i class="icon-l icon-mountain"></i>
            </div>
            <div class="right-menu-content">
                <span>Elevation Data</span>
            </div>
        </div>
        <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowBuildingObjects ? "selected" : "")" @onclick="() => UserMapSettings.ShowBuildingObjects = !UserMapSettings.ShowBuildingObjects">
                <i class="bi bi-building"></i>
            </div>
            <div class="right-menu-content">
                <span>Building Objects</span>
            </div>
        </div>
        <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowDrawingLayer ? "selected" : "")" @onclick="() => UserMapSettings.ShowDrawingLayer = !UserMapSettings.ShowDrawingLayer">
                <i class="bi bi-brush"></i>
            </div>
            <div class="right-menu-content">
                <span>Drawing Layer</span>
            </div>
        </div>
    </div>

    <div class="right-menu-grouping h-50">
         
    </div>

     <div class="right-menu-grouping h-20">
       <div class="right-menu-item">
            <div class="right-menu-icon @(UserMapSettings.ShowFriendlyCursors ? "selected" : "")" @onclick="() => UserMapSettings.ShowFriendlyCursors = !UserMapSettings.ShowFriendlyCursors">
                <i class="bi bi-cursor"></i>
            </div>
            <div class="right-menu-content">
                <span>Friendly Cursors</span>
            </div>
        </div>
    </div>
    
</div>