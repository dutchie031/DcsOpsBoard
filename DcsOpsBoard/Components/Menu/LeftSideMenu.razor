@using DcsMissionParser.Net
@using DcsMissionParser.Net.Objects.Coalitions.Countries.Groups
@using DcsMissionParser.Net.Objects.Commons
@using DcsOpsBoard.Components.Menu.LeftMenuItems
@using DcsOpsBoard.Database.Entities
@using DcsOpsBoard.Hubs.Clients
@using DcsOpsBoard.Services
@using DcsOpsBoard.Types.Enums

@rendermode InteractiveServer

@inject IMissionEditingClient MissionEditingClient

@code {

    private DcsMission? CurrentMission => MissionEditingClient.CurrentMission;

    protected override void OnInitialized()
    {
        MissionEditingClient.OnMissionChanged += MissionChanged;
        MissionEditingClient.OnMissionReceived += MissionReceived;
        base.OnInitialized();
    }

    private async Task MissionChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private record MenuGrouping
    {
        public required string Name { get; init; }
        public required bool IsClient { get; init; }
        public required CoalitionSide CoalitionSide { get; init; }
    }

    private Dictionary<MenuGrouping, List<PlaneGroup>> PlanesByGrouping = [];

    private async Task MissionReceived()
    {
        PlanesByGrouping.Clear();

        if (CurrentMission != null)
        {
            PlanesByGrouping = CurrentMission.Coalitions.All
                .SelectMany(coalition =>
                    coalition.Countries.SelectMany(country =>
                        country.Planes.Groups.Select(group => new
                        {
                            Coalition = coalition.Name ?? "Unknown",
                            Group = group,
                            IsClient = group.Units.Any(u => u.Skill == Skill.Client)
                        })
                    )
                )
                .GroupBy(x => new MenuGrouping
                {
                    Name = x.Coalition + ((x.IsClient) ? " (Clients)" : ""),
                    IsClient = x.IsClient,
                    CoalitionSide = x.Coalition.ToLower() switch
                    {
                        "blue" => CoalitionSide.Blue,
                        "red" => CoalitionSide.Red,
                        "neutrals" => CoalitionSide.Neutral,
                        _ => CoalitionSide.Unknown
                    }
                })
                .ToDictionary(
                    g => g.Key,
                    g => g.Select(x => x.Group).ToList()
                );

        }

        await InvokeAsync(StateHasChanged);
    }

    
}

<div id="left-menu-body">
    @if (CurrentMission != null)
    {
        foreach (var grouping in PlanesByGrouping)
        {
            <PlaneGroupGrouping GroupingName="@grouping.Key.Name" Groups="@grouping.Value"></PlaneGroupGrouping>
        }
    }
</div>


