@using DcsMissionParser.Net.Objects.Coalitions.Countries.Groups
@using DcsOpsBoard.Services

@inject IUnitSelectorService UserSelectorService

@code {

    [Parameter]
    public required string GroupingName { get; set; }

    [Parameter]
    public required List<PlaneGroup> Groups { get; set; }

    private bool IsExpanded { get; set; } = false;

    private Guid SelectedId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        UserSelectorService.OnGroupSelected += OnSelectionChanged;
    }

    public async Task OnSelectionChanged(UnitSelectedArgs args)
    {
        if(args.SelectedType == typeof(PlaneGroup) && args.SelectedUnit is PlaneGroup group)
        {
            SelectedId = group.RefId;
        }
        else
        {
            SelectedId = Guid.Empty;
        }
        StateHasChanged();
    }

}

<div class="container-fluid">

    <div class="row">
        <div class="col-12">
            <div class="grouping-header" @onclick="() => IsExpanded = !IsExpanded">
                <h3>
                    <span>@GroupingName</span>
                    <span class="expand-icon">@((IsExpanded) ? "-" : "+")</span>
                </h3>
               
            </div>
        </div>
    </div>
    <div class="row grouping-row @(IsExpanded ? "expanded" : "")">
        <div class="col-12">
            @foreach(var group in Groups)
            {
                <div class="group-item @(group.RefId == SelectedId ? "selected" : "")" @key="group.RefId" @onclick="() => UserSelectorService.SelectPlaneGroup(group)">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12">
                                 <span>@group.GroupName</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <span>@group.Units.Count() Units</span>
                            </div>
                        </div>
                    </div>
                    
                </div>
            }
        </div>
    </div>

</div>

