@using DcsMissionParser.Net.Objects.Coalitions.Countries.Groups
@using DcsOpsBoard.Components.Modals.FlightModals
@using DcsOpsBoard.Components.PlanningComponents.ShapeTypes
@using DcsOpsBoard.Services

@inject ISelectorService UserSelectorService
@inject IFlightModalService FlightModalService

@code {

    [Parameter]
    public required string GroupingName { get; set; }

    [Parameter]
    public required List<PlaneGroup> Groups { get; set; }

    private bool IsExpanded { get; set; } = false;

    private Guid SelectedId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        UserSelectorService.OnObjectSelected += OnSelectionChanged;
    }

    public async Task OnSelectionChanged(ObjectSelectedArgs args)
    {
        if(args.SelectedObjectRefId != Guid.Empty)
        {
            SelectedId = args.SelectedObjectRefId;
        }
        else
        {
            SelectedId = Guid.Empty;
        }
        StateHasChanged();
    }

    public async Task ToggleSelection(PlaneGroup group)
    {
        if(group.RefId == SelectedId)
        {
            await UserSelectorService.UnselectAll();
        } 
        else
        {
            await UserSelectorService.SelectRefId(group.RefId, DcsShapeType.Group);
            await FlightModalService.ShowEditFlightModal(group, false);
        }
    }

}

<div class="container-fluid">

    <div class="row">
        <div class="col-12">
            <div class="grouping-header" @onclick="() => IsExpanded = !IsExpanded">
                <h5>
                    <span>@GroupingName</span>
                    <span class="expand-icon">@((IsExpanded) ? "-" : "+")</span>
                </h5>
            </div>
        </div>
    </div>
    <div class="row grouping-row @(IsExpanded ? "expanded" : "")">
        <div class="col-12">
            @foreach(var group in Groups)
            {
                <div class="group-item @(group.RefId == SelectedId ? "selected" : "")" @key="group.RefId" @onclick="() => ToggleSelection(group)">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12">
                                 <span>@group.GroupName</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <span>@group.Units.Count() Units</span>
                            </div>
                        </div>
                    </div>
                    
                </div>
            }
        </div>
    </div>

</div>

