@using DcsOpsBoard.Components.Modals
@using DcsOpsBoard.Database.Entities
@using DcsOpsBoard.Database.Services
@using DcsOpsBoard.Services

@rendermode InteractiveServer

@inject IUserAuthenticationState authState
@inject IMissionStorageManager MissionStorageManager

@code {

    private NewMissionComponent? _newMissionModal;

    private bool keepOpen = false;


    public void OnModalVisibilityChanged(bool visible)
    {
        keepOpen = visible; //When model is visible keep menu open, when not visible, allow it to close
        StateHasChanged();
    }

    public List<OpsPlanningMission> _myMissions = [];

    public async Task OnNewMissionCreated()
    {
        _myMissions = await MissionStorageManager.GetMissions(
            m => m.OwnerId == authState.DiscordId
        );
        StateHasChanged();
    }

    private async void AuthenticationStateChanged()
    {
        if(!authState.IsAuthenticated)
        {
            _myMissions = [];
            StateHasChanged();
            return;
        }

        _myMissions = await MissionStorageManager.GetMissions(
            m => m.OwnerId == authState.DiscordId
        );
        StateHasChanged();
    }
    
    protected override async Task OnInitializedAsync()
    {
        authState.OnAuthenticationStateChanged += AuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await authState.EnsureLoaded();
        if (firstRender && authState.IsAuthenticated)
        {
            _myMissions = await MissionStorageManager.GetMissions(
                m => m.OwnerId == authState.DiscordId
            );
            StateHasChanged();
        }
    }
    
    private void OnMissionDeleted(OpsPlanningMission mission)
    {
        _myMissions.RemoveAll(m => m.MissionId == mission.MissionId);
        StateHasChanged();
    }

    private void ShowNewMissionModal()
    {
        keepOpen = true;
        StateHasChanged();
        _newMissionModal?.ShowNew();
    }
}

<NewMissionComponent @ref="_newMissionModal" ModalVisibilityChanged="OnModalVisibilityChanged" MissionCreated="OnNewMissionCreated" />

<div class="top-menu-body @((keepOpen ? "locked-open" : ""))">
    <div class="top-menu-header">
        <h1>DCS Ops Board</h1>

        <div class="user-info">
            <div class="user-header-info">

                @if (authState.IsAuthenticated)
                {
                    <img id="user-avatar" src="@authState.AvatarUrl" alt="?"/>
                    <span id="user-name">@authState.Username</span>
                } 
                else 
                {
                    <a class="login-link" href="/api/account/login">Log In Now</a>
                }
            </div>
            <div class="user-info-content">
                @if (authState.IsAuthenticated)
                {
                    <a class="login-link" href="/api/account/logout">Log Out</a>
                }
            </div>
        </div>
    </div>
     
    <div class="top-menu-content">
        <div class="container w-100">
        @{
            if(!authState.IsAuthenticated)
            {
                <div class="alert alert-warning" role="alert">
                    You are not logged in. Please log in to access all features of the DCS Ops Board.
                </div>
            } 
            else 
            {
                <div class="row">
                    <div class="col-3">
                        <h2>My Missions</h2>
                    </div>
                    <div class="col-3">
                        <div class="btn btn-primary" @onclick="ShowNewMissionModal">Create New Mission</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-7">
                        @if (_myMissions.Count == 0)
                        {
                            <p>You have no missions. Create one to get started!</p>
                        } 
                        else 
                        {
                            <div class="container">
                                @foreach (var mission in _myMissions)
                                {
                                    <MissionManagementItem @key="mission.MissionId" Mission="mission" ModalVisibilityChanged="OnModalVisibilityChanged" MissionDeleted="OnMissionDeleted" />
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        </div>
        
    </div>
</div>



